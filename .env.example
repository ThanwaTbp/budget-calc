# ตั้งค่าโปรเจค Appwrite (สมัครฟรีที่ https://cloud.appwrite.io)
# 1) สร้าง Project แล้วคัดลอก Project ID มาใส่
# 2) ที่ Project > Settings > Platforms เพิ่ม Web platform hostname = localhost (และโดเมนจริงตอน deploy)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# ใช้เฉพาะตอนรัน bun run setup:appwrite (server key ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
# สร้างที่ Appwrite Console > Project > Overview > Integrations > API Keys
# ต้องมี scope: databases.read, databases.write, collections.read, collections.write, attributes.read, attributes.write, indexes.read, indexes.write
APPWRITE_API_KEY=

# ปกติไม่ต้องตั้ง — ตั้งเฉพาะกรณีโปรเจค Appwrite สร้าง database ใหม่ไม่ได้ (แผนฟรีจำกัดจำนวน)
# สคริปต์ setup:appwrite จะบอก id ของ database ที่ใช้ได้ให้เอง แล้วนำมาใส่ตรงนี้
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# ใช้ดึงราคาหุ้นสหรัฐฯ ผ่าน Route Handler ฝั่งเซิร์ฟเวอร์เท่านั้น
# สมัคร API key ได้ที่ https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
